# YUNSI 云丝 — 环境模板（复制为 .env.local 填写，勿提交真实值）

# ---------------------------------------------------------------------------
# Supabase
# 未配置时站点自动降级为本地 seed 数据（src/data/products.ts）与本地商品图（public/products/）。
# NEXT_PUBLIC_SUPABASE_URL 一旦配置，商品图会自动切到 Supabase Storage 公共桶
#   <url>/storage/v1/object/public/product-images/<slug>.png
# （见 src/data/products.ts 的 productImageSrc / heroImageSrc）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 服务端 API（订单写入）用 service_role
SUPABASE_SERVICE_ROLE_KEY=
# 可选：若 Storage 端点与默认 /storage/v1/object/public 不同，可显式覆盖
NEXT_PUBLIC_SUPABASE_STORAGE_BASE=

# ---------------------------------------------------------------------------
# 支付（M4 接入时填写）
# 支付宝
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
# 微信支付
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_API_KEY=
WECHAT_PAY_CERT_SERIAL=
